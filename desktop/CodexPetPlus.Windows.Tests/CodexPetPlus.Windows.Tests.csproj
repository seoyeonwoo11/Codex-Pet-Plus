<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- This is an independent synthetic host, not the installed Codex application. -->
    <AssemblyName>ChatGPT</AssemblyName>
    <ApplicationManifest>../CodexPetPlus.Windows/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexPetPlus.Core/CodexPetPlus.Core.csproj" />
    <Compile Include="../CodexPetPlus.Windows/NativeWindows.cs" Link="NativeWindows.cs" />
    <Compile Include="../CodexPetPlus.Windows/OverlayWindow.xaml.cs" Link="OverlayWindow.xaml.cs" />
    <Page Include="../CodexPetPlus.Windows/OverlayWindow.xaml" Link="OverlayWindow.xaml" />
  </ItemGroup>
</Project>
