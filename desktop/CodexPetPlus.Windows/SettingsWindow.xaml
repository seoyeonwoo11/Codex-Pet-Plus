<Window x:Class="CodexPetPlus.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Pet Plus" Width="620" Height="740" MinWidth="530" MinHeight="550" Background="#F6F7F2" FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="펫 아래, 남은 한도" FontSize="25" FontWeight="SemiBold" Foreground="#2C3428"/>
    <TextBlock Text="기본 펫과 커스텀 펫을 자동으로 찾아 한도를 표시해요." Margin="0,10,0,22" Foreground="#7C8772"/>
    <Border Background="White" BorderBrush="#E0E5D8" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18"><StackPanel>
      <TextBlock Text="ChatGPT / Codex 앱 모드" FontSize="17" FontWeight="SemiBold" Foreground="#2C3428"/>
      <TextBlock x:Name="ModVersionText" Margin="0,8,0,12" FontSize="12" Foreground="#64794D"/>
      <TextBlock x:Name="DetectedAppVersionText" Text="감지한 앱 버전: 확인 중" Margin="0,0,0,12" FontSize="12" Foreground="#64794D" TextWrapping="Wrap"/>
      <TextBlock Text="앱 실행 파일 · 실행 중인 앱이나 설치된 Windows 패키지에서 자동 검색" FontSize="11" Foreground="#7C8772" TextWrapping="Wrap"/>
      <DockPanel Margin="0,7,0,14"><Button Content="찾기…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ChooseDesktopApp"/><TextBox x:Name="DesktopAppPath"/></DockPanel>
      <WrapPanel><Button x:Name="InstallModButton" Content="모드 설치 / 다시 설치" Click="InstallMod"/><Button x:Name="LaunchModButton" Content="모드 앱 실행" Click="LaunchMod"/><Button Content="상태 확인" Click="CheckModStatus"/><Button Content="설치 폴더 열기" Click="OpenModFolder"/></WrapPanel>
      <TextBlock x:Name="ModStatusText" Text="앱을 찾는 중입니다." Margin="0,12,0,0" Foreground="#64794D" TextWrapping="Wrap"/>
      <TextBlock Text="사용자 폴더에 앱 복사본을 만들고 모드를 설치합니다. 설치 후 앱을 트레이에서도 완전히 종료한 뒤 ‘모드 앱 실행’ 또는 시작 메뉴의 Codex Pet Plus로 여세요. 앱에서 원하는 펫을 켜면 한도가 자동으로 붙습니다." Margin="0,14,0,0" FontSize="12" Foreground="#7C8772" TextWrapping="Wrap" LineHeight="19"/>
      <TextBlock Text="비공식 앱 모드입니다. 복사본의 실행 파일 서명이 달라지며, 앱 업데이트 후에는 해당 버전에 맞는 모드를 다시 설치해야 합니다." Margin="0,10,0,0" FontSize="11" Foreground="#8B7560" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Expander Header="별도 표시줄로 연결하기"><StackPanel Margin="0,12,0,0">
    <CheckBox x:Name="CompanionOverlay" Content="별도 표시줄 사용 (모드와 함께 켜면 중복 표시됩니다)" Margin="0,0,0,12"/>
    <Border Background="White" BorderBrush="#E0E5D8" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel>
      <TextBlock Text="앱에서 원하는 펫을 켜면 자동으로 연결합니다." FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="기본 펫과 커스텀 펫 모두 같은 방식으로 사용하세요. 펫을 다시 켜거나 앱을 재시작해도 자동으로 다시 찾습니다." Margin="0,8,0,15" FontSize="12" Foreground="#7C8772" TextWrapping="Wrap"/>
      <Button Content="펫 자동으로 다시 찾기" HorizontalAlignment="Left" Click="FindPet"/>
      <TextBlock x:Name="PetStatusText" Text="펫 창을 찾는 중" Margin="0,12,0,0" Foreground="#64794D" TextWrapping="Wrap"/>
      <Expander Header="자동으로 찾지 못할 때 직접 선택" Margin="0,14,0,0"><StackPanel>
        <TextBlock Text="버튼을 누르고 마우스를 펫 몸 위에 올려두세요." Margin="0,10,0,10" FontSize="12" Foreground="#7C8772" TextWrapping="Wrap"/>
        <Button x:Name="SelectPetButton" Content="펫 선택 (3초 후)" HorizontalAlignment="Left" Click="SelectPet"/>
      </StackPanel></Expander>
    </StackPanel></Border>
    <TextBlock Text="Codex 연결" Margin="0,22,0,12" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="UsageStatusText" Text="한도 확인 중" Foreground="#64794D" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock Text="연결 도구 경로 · 비워두면 Codex 설치 폴더에서 자동 검색" FontSize="11" Foreground="#7C8772" TextWrapping="Wrap"/>
    <DockPanel Margin="0,7,0,14"><Button Content="찾기…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ChooseExecutable"/><TextBox x:Name="ExecutablePath"/></DockPanel>
    <CheckBox x:Name="RecentRecords" Content="앱 연결 실패 시 최근 사용량 기록 표시" Margin="0,0,0,12"/>
    <TextBlock Text="기록 폴더 · 기본값은 사용자 폴더의 .codex" FontSize="11" Foreground="#7C8772"/>
    <TextBox x:Name="RecordsPath" Margin="0,7,0,18"/>
    <StackPanel Orientation="Horizontal"><Button Content="설정 저장 · 새로고침" Click="Save"/><Button Content="새로고침" Click="Refresh"/></StackPanel>
    <TextBlock Text="표시줄은 펫의 위치를 따라갑니다. 아래 공간이 부족하면 위에 표시하며, 펫이 숨겨지면 함께 숨겨집니다. 표시줄 우클릭 또는 작업 표시줄의 트레이 아이콘에서 설정과 종료를 선택할 수 있어요." TextWrapping="Wrap" Margin="0,20,0,0" Foreground="#8B9482" FontSize="11" LineHeight="18"/>
    </StackPanel></Expander>
    <TextBlock Text="설치된 앱에서의 펫 화면과 계정 한도 조회는 실제 PC에서 확인해 주세요. 앱 파일 구조가 맞지 않으면 설치를 중단합니다." TextWrapping="Wrap" Margin="0,20,0,0" Foreground="#8B9482" FontSize="11" LineHeight="18"/>
  </StackPanel></ScrollViewer>
</Window>
