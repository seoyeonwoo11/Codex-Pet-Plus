<Window x:Class="CodexPetPlus.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Pet Plus" Width="580" Height="650" MinWidth="500" MinHeight="500" Background="#F6F7F2" FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="펫 위, 남은 한도" FontSize="25" FontWeight="SemiBold" Foreground="#2C3428"/>
    <TextBlock Text="기본 펫과 커스텀 펫을 찾아 위에서 따라다녀요." Margin="0,10,0,8" Foreground="#7C8772" TextWrapping="Wrap"/>
    <TextBlock x:Name="VersionText" Margin="0,0,0,22" FontSize="11" Foreground="#7C8772"/>
    <Border Background="White" BorderBrush="#E0E5D8" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel>
      <CheckBox x:Name="FollowerEnabled" Content="펫 위에 한도 표시" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Text="평소처럼 Codex 앱에서 원하는 펫을 켜 주세요. 펫을 움직이면 표시줄이 따라가고, 숨기면 함께 숨겨집니다." Margin="0,12,0,14" FontSize="12" Foreground="#7C8772" TextWrapping="Wrap" LineHeight="19"/>
      <TextBlock x:Name="PetStatusText" Text="펫 창을 찾는 중" Foreground="#64794D" TextWrapping="Wrap"/>
      <Button Content="펫 자동으로 다시 찾기" HorizontalAlignment="Left" Margin="0,14,0,0" Click="FindPet"/>
      <Expander Header="자동으로 찾지 못할 때 직접 선택" Margin="0,14,0,0"><StackPanel>
        <TextBlock Text="버튼을 누르고 3초 동안 마우스를 펫 몸 위에 올려두세요." Margin="0,10,0,10" FontSize="12" Foreground="#7C8772" TextWrapping="Wrap"/>
        <Button x:Name="SelectPetButton" Content="펫 선택 (3초 후)" HorizontalAlignment="Left" Click="SelectPet"/>
      </StackPanel></Expander>
    </StackPanel></Border>
    <TextBlock Text="남은 Codex 한도" Margin="0,22,0,10" FontSize="15" FontWeight="SemiBold" Foreground="#2C3428"/>
    <TextBlock x:Name="UsageStatusText" Text="한도 확인 중" Foreground="#64794D" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Button Content="한도 새로고침" HorizontalAlignment="Left" Click="Refresh"/>
    <Expander Header="한도 연결 설정" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="기존 Codex 로그인으로 한도를 조회합니다. 연결하지 못할 때만 경로를 지정하세요." FontSize="12" Foreground="#7C8772" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="연결 도구 경로 · 비워두면 자동 검색" FontSize="11" Foreground="#7C8772"/>
      <DockPanel Margin="0,7,0,14"><Button Content="찾기…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ChooseExecutable"/><TextBox x:Name="ExecutablePath"/></DockPanel>
      <CheckBox x:Name="RecentRecords" Content="연결 실패 시 최근 사용량 기록 표시" Margin="0,0,0,12"/>
      <TextBlock Text="기록 폴더 · 기본값은 사용자 폴더의 .codex" FontSize="11" Foreground="#7C8772"/>
      <TextBox x:Name="RecordsPath" Margin="0,7,0,14"/>
      <Button Content="연결 설정 저장 · 새로고침" HorizontalAlignment="Left" Click="Save"/>
    </StackPanel></Expander>
    <TextBlock Text="위쪽 공간이 부족하면 펫 아래에 표시합니다. 표시줄 우클릭 또는 트레이 아이콘에서 설정과 종료를 선택하세요. 설정 창을 닫아도 표시줄은 계속 실행됩니다." TextWrapping="Wrap" Margin="0,20,0,0" Foreground="#8B9482" FontSize="11" LineHeight="18"/>
    <Expander x:Name="LegacyRecovery" Header="이전 앱 모드 복원" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="이전 버전에서 앱에 직접 패치했다면 여기서 원본을 복원할 수 있습니다. 복원 전에는 Codex 앱을 트레이에서도 완전히 종료해 주세요. 이번 표시줄은 앱 파일을 수정하지 않습니다." FontSize="12" Foreground="#7C8772" TextWrapping="Wrap" LineHeight="19"/>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="RestoreModButton" Content="원본 복원" Click="RestoreMod"/><Button Content="복원 상태 확인" Click="CheckModStatus"/><Button x:Name="BackupFolderButton" Content="백업 폴더 열기" Click="OpenModFolder"/></WrapPanel>
      <TextBlock x:Name="ModStatusText" Text="이전 패치 기록을 확인합니다." Margin="0,12,0,0" Foreground="#64794D" TextWrapping="Wrap"/>
    </StackPanel></Expander>
  </StackPanel></ScrollViewer>
</Window>
